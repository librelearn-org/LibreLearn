generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  forumBanned   Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  theme         String    @default("023824")

  sessions               Session[]
  accounts               Account[]
  lists                  list[]
  trueFlags              flag[]                  @relation("trueUser")
  falseFlags             flag[]                  @relation("falseUser")
  learnSessions          learnSession[]
  userPermanentCardDatas userPermanentCardData[]
  listSettings           userListSettings[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model config {
  id        String   @id @unique @default(uuid())
  key       String   @unique
  value     Boolean
  isConfig  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model list {
  id            String             @id @unique @default(uuid())
  name          String
  listItems     listItemSaved[]
  owner         User               @relation(fields: [ownerId], references: [id])
  ownerId       String
  language      String             @default("NL")
  fromLanguage  String
  toLanguage    String
  learnSessions learnSession[]
  userSettings  userListSettings[]
}

model listItemSaved {
  id       String @id @unique @default(uuid())
  vraag    String
  antwoord String

  list   list?   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String?
}

enum learnSessionTypes {
  SESSION
  SPACED
}

enum learnFormat {
  toets
  leren
  gedachten
}

model learnSession {
  id             String             @id @default(uuid())
  type           learnSessionTypes  @default(SESSION)
  learnFormat    learnFormat        @default(gedachten)
  owner          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  list           list?              @relation(fields: [listId], references: [id], onDelete: SetNull)
  listId         String?
  config         Json               @default("{}")
  cards          learnSessionCard[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  methodId       String             @default("simple")
  graderId       String             @default("basic")
  queueUpdaterId String             @default("simple")

  @@index([userId, learnFormat, listId])
}

model learnSessionCard {
  id             String        @id @default(uuid())
  question       String
  answer         String
  phase          Int           @default(2) // Phase.NotIntroduced
  queueIndex     Int? // null = klaar, 0..n = exacte volgorde in wachtrij
  lastReviewed   DateTime?
  nextReview     DateTime      @default(now())
  metaData       Json          @default("{}")
  history        cardHistory[]
  learnSession   learnSession  @relation(fields: [learnSessionId], references: [id], onDelete: Cascade)
  learnSessionId String
  methodId       String        @default("simple")

  @@index([learnSessionId, queueIndex])
}

// deze voegt same met de linked metadata om een idee van hoe je een kaart moet onthouden en hoe je het hebt geleerd te behouden na het verwijderen van de session
model userPermanentCardData {
  id        String           @id @default(uuid())
  owner     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  question  String
  answer    String
  metaData  linkedMetaData[]
  history   cardHistory[]
  updatedAt DateTime         @updatedAt

  @@unique([userId, question, answer])
  @@index([userId])
}

model linkedMetaData {
  id                      String                @id @default(uuid())
  method                  String
  phase                   Int                   @default(2) // Phase.NotIntroduced
  lastReviewed            DateTime?
  nextReview              DateTime              @default(now())
  data                    Json                  @default("{}")
  userPermanentCardData   userPermanentCardData @relation(fields: [userPermanentCardDataId], references: [id], onDelete: Cascade)
  userPermanentCardDataId String

  @@unique([userPermanentCardDataId, method])
  @@index([method, nextReview])
}

model userListSettings {
  id          String            @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  list        list              @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId      String
  type        learnSessionTypes @default(SESSION)
  learnFormat learnFormat       @default(gedachten)

  targetDate DateTime?
  config     Json      @default("{}")
  updatedAt  DateTime  @updatedAt

  @@unique([userId, listId])
}

model cardHistory {
  id                      String                 @id @default(uuid())
  cardId                  String?
  date                    DateTime               @default(now())
  answer                  String
  grade                   Int // Grade enum: 0 (Incorrect), 1 (Hard), 2 (Good), 3 (Easy)
  userPermanentCardData   userPermanentCardData? @relation(fields: [userPermanentCardDataId], references: [id], onDelete: Cascade)
  userPermanentCardDataId String?
  learnSessionCard        learnSessionCard?      @relation(fields: [learnSessionCardId], references: [id], onDelete: SetNull)
  learnSessionCardId      String?

  @@index([userPermanentCardDataId])
  @@index([learnSessionCardId])
  @@map("learnSessionItemHistory")
}

model flag {
  // de id is een door mens leesbare id bijv 26.08.02.AB.klas-or-group of 26.09.05.feat.dc-integration het vormaat is YY.MM.DD.feat/fix/AB.naam-van-flag
  id        String    @id @unique
  startDate DateTime  @default(now())
  endDate   DateTime?
  closed    Boolean   @default(false)
  closedTo  Boolean?

  // voor nieuwe gebruikers en de initele toepassing van de flag
  defaultValue Boolean @default(false)
  trueChance   Int     @default(0)

  // de gebruiker hun relatie met de flag
  trueUser  User[] @relation("trueUser")
  falseUser User[] @relation("falseUser")
}
